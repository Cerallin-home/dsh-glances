{
  "name": "dsh-glances",
  "version": "0.1.0",
  "description": "Raspberry Pi monitoring for DSH: CPU, load, memory, swap, disk, temperature and fan via the glances REST API",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/**/*",
    "cordis.patch.yml",
    "README.md"
  ],
  "bin": {
    "dsh-glances-status": "lib/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "glances",
    "monitoring",
    "raspberry-pi"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
